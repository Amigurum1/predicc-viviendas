# ============================================================
# PLANTILLA DE CONFIGURACIÓN
# ============================================================
# Copia este fichero a `.env` y ajusta los valores:
#
#     cp .env.example .env        (Linux/macOS)
#     copy .env.example .env      (Windows)
#
# El `.env` real NO se versiona (ver .gitignore) porque contiene la SECRET_KEY.
# ============================================================

# ============================================================
# ENTORNO
# ============================================================
# development | testing | production
# - development: CORS abierto a cualquier origen, /docs accesible
# - production: CORS restringido a CORS_ORIGINS, sin /docs, secretos obligatorios
ENVIRONMENT=development
DEBUG=True

# ============================================================
# SERVIDOR
# ============================================================
HOST=0.0.0.0
PORT=8000
WORKERS=1
# Recarga automática al guardar. Deja False en producción.
RELOAD=True

# ============================================================
# SEGURIDAD
# ============================================================
# ⚠️ OBLIGATORIO CAMBIARLO. En producción el arranque valida que tenga al
# menos 32 caracteres y falla si sigue el valor por defecto.
#
# Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# BASE DE DATOS
# ============================================================
# Desarrollo local:
DATABASE_URL=sqlite:///./app.db
# Docker (volumen persistente, ver docker-compose.yml):
# DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/predicc

# ============================================================
# MODELO DE MACHINE LEARNING
# ============================================================
# Se regeneran con: python src/models/train_model.py
MODEL_PATH=models_saved/RandomForest_Tuned.pkl
SCALER_PATH=models_saved/scaler.pkl
FEATURES_PATH=models_saved/feature_names.txt

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=app.log

# ============================================================
# CORS
# ============================================================
# Solo se usa cuando ENVIRONMENT=production (en desarrollo se permite todo).
CORS_ORIGINS=http://localhost:5500,http://localhost:8000

# ============================================================
# LÍMITE DE PETICIONES
# ============================================================
# Límite en memoria por IP para los endpoints sensibles (/auth y /predictions).
# Ojo: es por proceso. Con varios workers, o en producción, usa Redis.
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

